# Phoenix
SECRET_KEY_BASE=your_secret_key_base_here  # mix phx.gen.secret
PHX_HOST=localhost
PHX_SERVER=true
PORT=4000

# Database
DATABASE_URL=ecto://postgres:postgres@localhost:5433/dev_pulse_live_dev
ECTO_IPV6=false  # true on Fly.io
POOL_SIZE=10

# GitHub
GITHUB_TOKEN=ghp_your_personal_access_token  # scopes: read:user, repo
GITHUB_WEBHOOK_SECRET=your_webhook_secret
GITHUB_ACTOR=your_github_username

# Poller (optional)
POLLER_INTERVAL_MS=60000
